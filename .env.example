# ===== 应用 =====
APP_NAME=Knowledge Platform API
VERSION=0.1.0
ENV=dev
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_platform
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_platform

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Milvus =====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=document_chunks

# ===== 安全 =====
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 模型服务（vLLM / OpenAI 兼容接口）=====
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen2.5-14B-Instruct-AWQ
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# LLM 后端：openai（OpenAI 兼容接口）/ mock（确定性假回答，开发/测试）
LLM_BACKEND=openai
LLM_TIMEOUT_SECONDS=120

# ===== 向量化入库（TECH_DESIGN：BGE-M3 稠密 1024d + 稀疏）=====
# flagembedding：本地 FlagEmbedding 推理（需 pip install FlagEmbedding，模型约 2.3GB 自动下载）
# mock：确定性伪向量（仅开发/测试，无模型依赖）
EMBEDDING_BACKEND=flagembedding
EMBEDDING_DEVICE=cpu
MILVUS_DIM=1024
VECTORIZE_BATCH_SIZE=32

# ===== 检索参数 =====
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
HYDE_ENABLED=false
HISTORY_WINDOW=3

# ===== 文档 =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ===== 解析 / 切片 =====
PARSE_BACKEND=background
CHUNK_SIZE_TOKENS=768
CHUNK_OVERLAP_TOKENS=100
CHUNK_MIN_TOKENS=32

# ===== 文件存储：local / minio =====
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# ===== 前端 =====
BACKEND_URL=http://localhost:8000
