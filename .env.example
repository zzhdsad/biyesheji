# ===== 应用 =====
APP_NAME=Knowledge Platform API
VERSION=0.1.0
ENV=dev
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_platform
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_platform

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Milvus =====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=document_chunks

# ===== 安全 =====
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 模型服务（vLLM / OpenAI 兼容接口）=====
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen2.5-14B-Instruct-AWQ
EMBEDDING_MODEL=BAAI/bge-m3
# LLM 后端：openai / deepseek / qwen / ollama / custom（均为 OpenAI 兼容协议）
LLM_BACKEND=openai
LLM_TIMEOUT_SECONDS=120

# ===== 向量化入库（TECH_DESIGN：BGE-M3 稠密 1024d + 稀疏）=====
# flagembedding：本地 FlagEmbedding 推理（模型权重随镜像内置，无需用户下载）
EMBEDDING_BACKEND=flagembedding
EMBEDDING_DEVICE=cpu
# 本地内置模型权重目录：留空则按 EMBEDDING_MODEL 从 HuggingFace 拉取
EMBEDDING_MODEL_PATH=
HF_HOME=
MILVUS_DIM=1024
VECTORIZE_BATCH_SIZE=32

# ===== 检索参数 =====
RECALL_TOP_K=10           # 每路召回数量（送入 RRF 融合）
RERANK_TOP_N=3            # 精排后返回给 LLM 的最终数量
RRF_K=60                  # RRF 融合平滑常数
RELEVANCE_THRESHOLD=0.35  # 相似度拒答阈值
# Rerank 后端：flagreranker（BGE-Reranker-v2-m3 真实精排，模型随镜像内置）
RERANK_BACKEND=flagreranker
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Rerank 本地模型路径：留空则按 RERANK_MODEL 加载（国内走 HF_ENDPOINT 镜像）
RERANK_MODEL_PATH=
RERANK_DEVICE=cpu
# ===== HyDE 查询改写（TECH_DESIGN §4.5：生成假设答案替换原问题检索）=====
# 默认开启且复用主 LLM（HYDE_MODEL / HYDE_BASE_URL 留空即可）；关闭用 HYDE_ENABLED=false
HYDE_ENABLED=true
HYDE_BACKEND=openai
HYDE_MODEL=
# HyDE 单独的小模型 API 地址：留空则复用 LLM_BASE_URL / LLM_MODEL
HYDE_BASE_URL=
HISTORY_WINDOW=5
TRASH_RETENTION_DAYS=7

# ===== 文档 =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ===== 解析 / 切片 =====
PARSE_BACKEND=background
CHUNK_SIZE_TOKENS=768
CHUNK_OVERLAP_TOKENS=100
CHUNK_MIN_TOKENS=32

# ===== 文件存储：local / minio =====
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# ===== 前端 =====
BACKEND_URL=http://localhost:8000

# 真实中医知识数据源根目录（导入中心扫描用，后端本机直读，不通过浏览器上传）
IMPORT_SOURCE_DIR=C:\毕设数据源
